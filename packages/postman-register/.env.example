# postman-register 运行配置
# Bun 会自动加载当前目录的 .env，无需额外安装 dotenv
# 请复制本文件为 .env 后再填写真实代理、密码等敏感配置，不要直接修改并提交本示例文件

# ── VPN / 代理 ────────────────────────────────────────
# 浏览器代理地址，支持 HTTP、HTTPS 和 SOCKS5，可包含用户名与密码
# 示例：http://host:port、http://user:pass@host:port、socks5://user:pass@host:port
# 遇到 temp-mail 或 Postman 按出口 IP 限流时可配置；留空表示直连
POSTMAN_PROXY=

# 是否通过代理查询出口 IP，并同步浏览器的 WebRTC 与地理位置
# 0=关闭，1=开启；仅在 POSTMAN_PROXY 非空时有意义
POSTMAN_GEOIP=0

# ── 注册行为 ─────────────────────────────────────────
# 批量注册轮数；命令行参数 --count N 的优先级高于此配置
POSTMAN_COUNT=1

# 固定注册密码；留空时每轮自动生成独立的 12 位随机密码
POSTMAN_PASSWORD=

# Cloudflare 校验的总等待时间，单位毫秒；默认 600000（10 分钟）
POSTMAN_CF_TIMEOUT=600000

# 账号 Token JSON 的保存目录；相对路径以当前包目录为基准
POSTMAN_TOKENS_DIR=tokens
