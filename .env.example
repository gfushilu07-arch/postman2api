# ── 服务 ─────────────────────────────────────────────
# HTTP 服务与管理面板监听端口
PORT=1930
# 管理面板开发端口；生产构建由 PORT 对外提供
DASHBOARD_PORT=1931
# 开发模式后端 API 端口；与正式运行的 PORT 分离
DEV_API_PORT=1932

# ── 鉴权与加密 ───────────────────────────────────────
# 调用 /v1/* 接口时使用的 API Key；部署前务必替换
API_KEY=postman2api-secret-key
# 用于加密本地敏感账号数据；部署前替换为强随机且唯一的密钥
ENCRYPTION_KEY=change-this-to-a-random-32-char-hex-string

# ── 数据库 ───────────────────────────────────────────
# 正式运行使用的 SQLite 数据库文件路径；仅 NODE_ENV=production 时读取
DATABASE_PATH=./data/postman2api.db
# 开发模式专用数据库；bun start / bun run dev 不会打开正式数据库
DEV_DATABASE_PATH=./data/postman2api.dev.db
# 测试专用数据库；bun test 会自动使用 NODE_ENV=test
TEST_DATABASE_PATH=./data/postman2api.test.db
# 请求详情清理后保留的最近记录数
REQUEST_LOG_RETAIN_COUNT=50
# 请求详情达到该数量后，批量清理到 REQUEST_LOG_RETAIN_COUNT
REQUEST_LOG_CLEANUP_THRESHOLD=100
# 请求详情和过期会话的检查间隔，单位毫秒；默认每 10 分钟检查一次
REQUEST_LOG_CLEANUP_INTERVAL_MS=600000
# 会话上下文闲置超过该天数后清理
SESSION_RETENTION_DAYS=30

# ── 上游网络与流式响应 ───────────────────────────────
# 等待上游响应头的最长时间，单位毫秒
TTFB_TIMEOUT_MS=45000
# 流式响应相邻数据块之间允许的最大空闲时间，单位毫秒
STREAM_READ_TIMEOUT_MS=300000
# 未单独设置首包超时时，提供商请求使用的兜底超时，单位毫秒
PROVIDER_REQUEST_TIMEOUT_MS=120000
# 额度安全流式响应对客户端可见前允许缓冲的最大字节数
# 如果上游已经生成部分内容后才报告额度耗尽，代理可丢弃不完整内容并切换账号重试
QUOTA_SAFE_STREAM_BUFFER_BYTES=16777216
# 缓冲或重试期间发送 SSE 注释心跳的间隔，单位毫秒
STREAM_KEEPALIVE_INTERVAL_MS=10000
# 是否输出安全的 Postman 请求生命周期诊断信息（仅路径、状态、耗时和字节数）
# 不会记录鉴权请求头，也不会记录请求体或响应体
POSTMAN_FETCH_VERBOSE=false

# ── 浏览器自动化 ─────────────────────────────────────
# 浏览器自动化使用的可选代理；不需要时保持注释
# BATCHER_PROXY_URL=http://user:pass@host:port

# 登录浏览器后端：camoufox（默认）或 playwright（Chromium）
LOGIN_BROWSER_BACKEND=camoufox
